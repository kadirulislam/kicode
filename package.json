{
  "name": "@kadirulislam/kicode",
  "version": "0.2.0",
  "description": "Bring-your-own-key terminal coding agent. OpenAI-compatible, no account, no server.",
  "type": "module",
  "bin": {
    "kicode": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "start": "node dist/cli.js",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:secrets": "node scripts/check-secrets.mjs --all",
    "mock": "node scripts/mock-provider.mjs"
  },
  "keywords": [
    "cli",
    "agent",
    "byok",
    "openai-compatible"
  ],
  "author": "Kadirul Islam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadirulislam/kicode.git"
  },
  "homepage": "https://github.com/kadirulislam/kicode#readme",
  "bugs": {
    "url": "https://github.com/kadirulislam/kicode/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.1"
  }
}
