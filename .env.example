# KiCode reads credentials from the environment only — it never writes a key
# to disk. Copy this file to `.env` and source it, or export these directly.
# Never put a real key in this file: it is committed.

# The key for a provider you declared in kicode.json. The name here is whatever
# that provider's "apiKeyEnv" says. This example declares "openai":
OPENAI_API_KEY=

# The endpoint is not set here. Declare it once, in kicode.json:
#
#   { "providers": { "openai": { "apiKeyEnv": "OPENAI_API_KEY" } } }
#
# or add one from inside the UI with /connect, which writes that block for you.
# An endpoint in the environment — OPENAI_BASE_URL, KICODE_BASE_URL — is ignored
# on purpose: a first run must not silently end up on a gateway nobody chose.
#
# Any OpenAI-compatible endpoint works as a provider's "baseUrl":
#   OpenAI      https://api.openai.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   Ollama      http://localhost:11434/v1

# Optional. Any model the endpoint serves, including tool-calling models. It
# has to exist on the endpoint you declared.
KICODE_MODEL=gpt-4o-mini

# Optional. Other provider keys referenced by "apiKeyEnv" in kicode.json.
# Their values belong in your own `.env`, not here.
