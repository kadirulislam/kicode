# KiCode reads credentials from the environment only — it never writes a key
# to disk. Copy this file to `.env` and source it, or export these directly.

# Required. KICODE_API_KEY wins; OPENAI_API_KEY is accepted as a fallback.
KICODE_API_KEY=

# Optional. Any OpenAI-compatible base URL.
#   OpenAI      https://api.openai.com/v1        (default)
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   Ollama      http://localhost:11434/v1
KICODE_BASE_URL=https://api.openai.com/v1

# Optional. Any model the endpoint serves, including tool-calling models.
KICODE_MODEL=deepseek-v4-flash

OPENCODE_API_KEY=

EXPERIENTIAL_LABS_API_KEY=
KENARI_API_KEY=
